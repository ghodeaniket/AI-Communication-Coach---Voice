# Voice-Based AI Communication Coach - Environment Variables
# Copy this file to .env and modify as needed for your environment

#######################
# Application Settings
#######################

# Environment name (development, staging, production)
NODE_ENV=development

# Application port for local development
PORT=5173

# Log level (debug, info, warn, error)
LOG_LEVEL=info

#######################
# API Configuration
#######################

# Base URL for API requests 
VITE_API_ENDPOINT=http://localhost:3000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# API version
VITE_API_VERSION=v1

#######################
# AWS Configuration
#######################

# AWS Region 
AWS_REGION=us-east-1

# AWS Access Key ID (for local development)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX

# AWS Secret Access Key (for local development)
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#######################
# Audio Processing
#######################

# Maximum recording duration in seconds
VITE_MAX_RECORDING_DURATION=120

# Default audio sample rate
VITE_AUDIO_SAMPLE_RATE=44100

# Enable background noise reduction
VITE_AUDIO_NOISE_REDUCTION=true

#######################
# External Services
#######################

# OpenAI API Key (for Whisper API)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Whisper Model
OPENAI_WHISPER_MODEL=whisper-1

#######################
# Database Configuration
#######################

# DynamoDB Table Name
DYNAMODB_TABLE=voice-coach-results

# DynamoDB Local Endpoint (for local development)
DYNAMODB_ENDPOINT=http://localhost:4566

#######################
# Security & Authentication
#######################

# CORS allowed origins (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.example.com

#######################
# Feature Flags
#######################

# Enable advanced speech metrics
VITE_FEATURE_ADVANCED_METRICS=false

# Enable comparison with previous recordings
VITE_FEATURE_RECORDING_COMPARISON=true
